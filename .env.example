# ==============================================================================
# TradeZen Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real configuration.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Database Configuration (PostgreSQL only)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tradezen

# Authentication Secrets
# Generate a secure 32+ character random secret for production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Market Data API (Upstox Analytics Token valid for 1 year)
UPSTOX_ANALYTICS_TOKEN=replace_with_your_upstox_analytics_token

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins. Use "*" for development across local Wi-Fi devices.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,*

# Backend Server Listening Configuration
# Use 0.0.0.0 to listen on all network interfaces (LAN/Wi-Fi devices can connect)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Frontend & API Base URL
# Backend exposes API relative to root or API prefix
API_BASE_URL=/api/v1

# Frontend Vite Dev Server settings
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_API_URL=http://localhost:8000
